# ============================================
# B2B Server — Environment Variables
# ============================================

# --- Server ---
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5001
VITE_API_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://admin:password@localhost:5432/b2b

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
DISABLE_2FA=false

# --- SMTP (email) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-smtp-password

# --- SMS (2FA) ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# --- 1C Integration ---
ONEC_BASE_URL=http://192.168.85.85:8080/UT_TEST/hs/api/integration
ONEC_USER=B2BAPI
ONEC_PASS=

# --- Backup (Docker) ---
BACKUP_CONTAINER_NAME=
BACKUP_DB_NAME=
BACKUP_DB_USER=
